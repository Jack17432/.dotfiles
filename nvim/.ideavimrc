set scrolloff=10
set linenumber
set showmode
set visualbell
set clipboard+=unnamed

set ignorecase
set smartcase
set incsearch
set hlsearch

let mapleader = " "

set surround
set highlightedyank
set sneak
set nerdtree
set easymotion
set notimeout
set which-key

let g:WhichKeyDesc_display = "<leader>d Display options"

